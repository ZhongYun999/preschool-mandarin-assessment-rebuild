# Local development only; replace placeholders with your own local credentials.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/vnext_dev
TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/vnext_test

# Explicit trusted browser origins for teacher login (comma separated).
VNEXT_AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Local HTTP development only; production defaults to true.
# VNEXT_AUTH_COOKIE_SECURE=false
# VNEXT_AUTH_SESSION_HOURS=24
# Optional: stable private image root (default: ignored uploads/taskbank).
# TASKBANK_ASSET_ROOT=/path/to/private/taskbank-assets

# Optional: private persistent preview root (default: ignored uploads/import-previews).
# TASKBANK_PREVIEW_ROOT=/path/to/private/import-previews

# Private fixed-audio content-addressed storage directory (optional).
# FIXED_AUDIO_ROOT=/path/to/private/fixed-audio

# DashScope API key is supplied privately; never commit an actual value.
DASHSCOPE_API_KEY=

# Private Fernet key for LLM provider credentials; generate and store securely.
VNEXT_LLM_PROVIDER_ENCRYPTION_KEY=
