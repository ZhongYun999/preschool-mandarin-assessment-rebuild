# Local development only; replace placeholders with your own local credentials.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/vnext_dev
TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/vnext_test

# Set a private value locally; required for all /teacher endpoints.
TEACHER_MANAGEMENT_TOKEN=
# Optional: stable private image root (default: ignored uploads/taskbank).
# TASKBANK_ASSET_ROOT=/path/to/private/taskbank-assets

# Optional: private persistent preview root (default: ignored uploads/import-previews).
# TASKBANK_PREVIEW_ROOT=/path/to/private/import-previews
